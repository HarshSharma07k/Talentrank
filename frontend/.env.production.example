# Vite inlines this at BUILD time, not at runtime -- changing it on Vercel
# requires a redeploy (Project Settings -> redeploy), not just an env edit.
#
# Set the real value in the Vercel project's Environment Variables
# (Production + Preview), not in a committed .env.production file.
VITE_API_BASE_URL=https://<hf-username>-talentrank.hf.space
