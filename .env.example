# Copy to .env and override as needed. All keys are prefixed TALENTRANK_ and are
# optional -- every one has a default in src/talentrank/config.py. Do not commit .env.

# "full" (123,849 postings, data/processed/) or "demo" (25k subsample, data/demo/).
TALENTRANK_CORPUS_PROFILE=full

# --- Models -----------------------------------------------------------------
TALENTRANK_BI_ENCODER_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TALENTRANK_CROSS_ENCODER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
TALENTRANK_EMBEDDING_BATCH_SIZE=64

# --- FAISS HNSW ---------------------------------------------------------------
TALENTRANK_HNSW_M=32
TALENTRANK_HNSW_EF_CONSTRUCTION=200
TALENTRANK_HNSW_EF_SEARCH=64

# --- Retrieval / rerank sizing ------------------------------------------------
TALENTRANK_DEFAULT_TOP_K=30
TALENTRANK_DEFAULT_TOP_N=10
TALENTRANK_MAX_TOP_K=200
TALENTRANK_MAX_TOP_N=50
TALENTRANK_MIN_RESUME_CHARS=40
TALENTRANK_MAX_RESUME_CHARS=20000
TALENTRANK_CROSS_ENCODER_MAX_LENGTH=256
TALENTRANK_CROSS_ENCODER_QUANTIZE=false
TALENTRANK_RERANK_TEXT_MAX_CHARS=1200

# --- Concurrency ---------------------------------------------------------------
TALENTRANK_TORCH_NUM_THREADS=2
TALENTRANK_MAX_CONCURRENT_INFERENCES=1
TALENTRANK_INFERENCE_QUEUE_TIMEOUT_SECONDS=20.0

# --- Cache -----------------------------------------------------------------
# "memory" or "redis". redis_url is only read when cache_backend=redis.
TALENTRANK_CACHE_BACKEND=memory
TALENTRANK_CACHE_TTL_SECONDS=3600
TALENTRANK_CACHE_MAX_ENTRIES=256
TALENTRANK_REDIS_URL=

# --- Rate limiting ---------------------------------------------------------
TALENTRANK_RATE_LIMIT_REQUESTS=30
TALENTRANK_RATE_LIMIT_WINDOW_SECONDS=60

# --- Upload / explainability / filters --------------------------------------
TALENTRANK_MAX_UPLOAD_BYTES=5000000
TALENTRANK_DESCRIPTION_MAX_CHARS=1200
TALENTRANK_EXPLAIN_MAX_TERMS=12
TALENTRANK_FILTER_OVERFETCH_FACTOR=3

# --- Demo corpus -------------------------------------------------------------
TALENTRANK_DEMO_CORPUS_SIZE=25000

# --- Persistence (enhancements/19) --------------------------------------------
# Unset -> derived as sqlite+aiosqlite:///{data_dir}/talentrank.db. Set to a
# postgresql+asyncpg://... URL for the hosted demo (enhancements/24).
TALENTRANK_DATABASE_URL=
# SQL logging; never enable in production, it logs parameter values.
TALENTRANK_DATABASE_ECHO=false
TALENTRANK_DATABASE_POOL_SIZE=5
TALENTRANK_DATABASE_MAX_OVERFLOW=10
TALENTRANK_DATABASE_POOL_RECYCLE_SECONDS=1800

# --- CORS / serving ----------------------------------------------------------
# Comma-separated list of allowed origins.
TALENTRANK_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Regex for Vercel preview deployments, e.g. ^https://talentrank-.*\.vercel\.app$
TALENTRANK_CORS_ALLOW_ORIGIN_REGEX=
TALENTRANK_API_PORT=8000
